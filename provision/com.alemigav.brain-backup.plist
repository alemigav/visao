<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.alemigav.brain-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/alemigav/.local/bin/brain-backup</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>21</integer>
		<key>Minute</key>
		<integer>17</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/alemigav/Library/Logs/brain-backup.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/alemigav/Library/Logs/brain-backup.log</string>
</dict>
</plist>
